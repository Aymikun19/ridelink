# ---- Frontend (exposed to the browser, safe to publish) ----
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---- Backend (server only, never prefix with VITE_) ----
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
RESEND_API_KEY=re_xxxxxxxxx
# Must be an address on a domain verified in Resend, e.g. "RideLink <no-reply@yourdomain.com>"
RESEND_FROM=RideLink <onboarding@resend.dev>
# Long random string used to hash OTP codes. Generate with: openssl rand -hex 32
OTP_SECRET=change-me
# Public URL of the deployed app, used in email links
APP_URL=http://localhost:5173
